# Gateway settings. Copy to .env for `make run` on the host; the upstream
# addresses below point at services started on their own ports.
PORT=8080
LOG_LEVEL=INFO
UPSTREAM_TIMEOUT=30s

CUSTOMER_UPSTREAM=http://localhost:8081
CATALOG_UPSTREAM=http://localhost:8082
BILLING_UPSTREAM=http://localhost:8083
EXECUTION_UPSTREAM=http://localhost:8084
HISTORY_UPSTREAM=http://localhost:8085
SERVICE_ORDER_UPSTREAM=http://localhost:8086

# Leave unset to keep POST /auth/customer-login disabled (the AWS API Gateway
# serves it in deployed environments; the local ecosystem sets it).
# LAMBDA_UPSTREAM=http://localhost:9001
